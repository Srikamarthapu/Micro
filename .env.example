# Google Maps key for the Nearby map.
# Console: enable "Maps JavaScript API", then add it to the key's API restrictions.
# Restrict the key to HTTP referrers (localhost:4174, 127.0.0.1:4174, deploy domain).
# Copy this file to .env.local and paste your key. .env.local is gitignored.
VITE_GOOGLE_MAPS_API_KEY=

# Map ID for Advanced (HTML) markers. Create one under Google Maps Platform ->
# Map management. Defaults to DEMO_MAP_ID, which is development-only.
VITE_GOOGLE_MAPS_MAP_ID=

# Browser-safe Supabase configuration for the Micro project.
# Add these values to the same ignored .env.local file.
VITE_SUPABASE_URL=https://fkhzqekrzuoatqhkzarx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
